model Transaction {
  id             String          @id @default(cuid())
  shopOwnerId    String
  customerId     String
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  idempotencyKey String?
  note           String?
  date           DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  shopOwner User     @relation(fields: [shopOwnerId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId, shopOwnerId], references: [id, shopOwnerId], onDelete: Cascade)

  @@unique([shopOwnerId, idempotencyKey])
  @@index([customerId, date])
  @@index([shopOwnerId])
  @@map("transactions")
}
